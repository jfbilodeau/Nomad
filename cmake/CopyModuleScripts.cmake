foreach(REQUIRED IN ITEMS NOMAD_MODULE_SOURCE NOMAD_MODULE_DESTINATION)
    if(NOT DEFINED ${REQUIRED} OR NOT IS_ABSOLUTE "${${REQUIRED}}" OR NOT IS_DIRECTORY "${${REQUIRED}}")
        message(FATAL_ERROR "${REQUIRED} must identify an existing absolute module directory")
    endif()
endforeach()

file(REAL_PATH "${NOMAD_MODULE_SOURCE}" SOURCE)
file(REAL_PATH "${NOMAD_MODULE_DESTINATION}" DESTINATION)
if(EXISTS "${SOURCE}/scripts" AND NOT IS_DIRECTORY "${SOURCE}/scripts")
    message(FATAL_ERROR "Module scripts path is not a directory: ${SOURCE}/scripts")
endif()
if(SOURCE STREQUAL DESTINATION)
    return()
endif()

file(REMOVE_RECURSE "${DESTINATION}/scripts")
if(IS_DIRECTORY "${SOURCE}/scripts")
    file(COPY "${SOURCE}/scripts" DESTINATION "${DESTINATION}")
endif()
