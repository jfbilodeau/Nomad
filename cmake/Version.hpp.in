#pragma once

#include <nomad/NomadVersion.hpp>

namespace nomad {

[[nodiscard]] inline constexpr NomadVersion getNomadVersion() {
    return {
        @PROJECT_VERSION_MAJOR@,
        @PROJECT_VERSION_MINOR@,
        @PROJECT_VERSION_PATCH@
    };
}

[[nodiscard]] inline constexpr NomadInteger getNomadVersionMajor() {
    return getNomadVersion().getMajor();
}

[[nodiscard]] inline constexpr NomadInteger getNomadVersionMinor() {
    return getNomadVersion().getMinor();
}

[[nodiscard]] inline constexpr NomadInteger getNomadVersionPatch() {
    return getNomadVersion().getPatch();
}

} // namespace nomad
