if(NOT DEFINED NOMAD_DISTRIBUTION_CONFIG)
    message(FATAL_ERROR "NOMAD_DISTRIBUTION_CONFIG is required")
endif()
include("${NOMAD_DISTRIBUTION_CONFIG}")
set(STAGING "${NOMAD_DISTRIBUTION_OUTPUT}/staging")
file(REMOVE_RECURSE "${STAGING}")
set(SDK "${STAGING}/sdk")
set(RUNTIME_BUNDLE "${SDK}/runtime")
file(MAKE_DIRECTORY "${SDK}" "${RUNTIME_BUNDLE}")

file(READ "${NOMAD_DISTRIBUTION_BUNDLE}/runtime.json" MANIFEST)
string(JSON VERSION GET "${MANIFEST}" version)
string(JSON PLATFORM GET "${MANIFEST}" target)
if(NOT VERSION STREQUAL NOMAD_DISTRIBUTION_VERSION OR NOT PLATFORM STREQUAL NOMAD_DISTRIBUTION_PLATFORM)
    message(FATAL_ERROR "Runtime bundle version or target does not match distribution")
endif()
string(JSON FILE_COUNT LENGTH "${MANIFEST}" files)
if(FILE_COUNT LESS 1)
    message(FATAL_ERROR "Runtime bundle has no files")
endif()
math(EXPR LAST_FILE "${FILE_COUNT} - 1")
foreach(INDEX RANGE ${LAST_FILE})
    string(JSON PATH GET "${MANIFEST}" files ${INDEX} path)
    get_filename_component(PARENT "${PATH}" DIRECTORY)
    file(COPY "${NOMAD_DISTRIBUTION_BUNDLE}/${PATH}" DESTINATION "${RUNTIME_BUNDLE}/${PARENT}")
endforeach()
file(COPY_FILE "${NOMAD_DISTRIBUTION_BUNDLE}/runtime.json" "${RUNTIME_BUNDLE}/runtime.json")
file(COPY "${RUNTIME_BUNDLE}/licenses" DESTINATION "${SDK}")
file(COPY "${NOMAD_DISTRIBUTION_TEMPLATES}/" DESTINATION "${SDK}/templates")
file(COPY "${NOMAD_DISTRIBUTION_DOCUMENTATION}" DESTINATION "${SDK}/docs")

foreach(PROGRAM IN ITEMS CLI COMPILER RUNTIME)
    set(NOMAD_RUNTIME "${NOMAD_DISTRIBUTION_${PROGRAM}}")
    set(NOMAD_RUNTIME_DESTINATION "${SDK}")
    unset(NOMAD_RUNTIME_DEPENDENCIES)
    if(DEFINED NOMAD_DISTRIBUTION_${PROGRAM}_DLLS)
        set(NOMAD_RUNTIME_DEPENDENCIES "${NOMAD_DISTRIBUTION_${PROGRAM}_DLLS}")
    endif()
    if(NOMAD_DISTRIBUTION_TOOLCHAIN_DLLS)
        if(NOMAD_RUNTIME_DEPENDENCIES)
            string(APPEND NOMAD_RUNTIME_DEPENDENCIES "|")
        endif()
        string(APPEND NOMAD_RUNTIME_DEPENDENCIES "${NOMAD_DISTRIBUTION_TOOLCHAIN_DLLS}")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/BundleRuntimeDependencies.cmake")
endforeach()

function(create_distribution_archive NAME ROOT)
    set(ARCHIVE_PATH "${NOMAD_DISTRIBUTION_OUTPUT}/${NAME}")
    set(TEMPORARY_ARCHIVE_PATH "${ARCHIVE_PATH}.tmp")
    file(REMOVE "${TEMPORARY_ARCHIVE_PATH}")
    execute_process(
        COMMAND "${CMAKE_COMMAND}"
            "-DNOMAD_ARCHIVE_OUTPUT=${TEMPORARY_ARCHIVE_PATH}"
            "-DNOMAD_ARCHIVE_ROOT=${ROOT}"
            -P "${CMAKE_CURRENT_LIST_DIR}/CreateArchive.cmake"
        WORKING_DIRECTORY "${ROOT}"
        RESULT_VARIABLE RESULT ERROR_VARIABLE ERROR_OUTPUT
    )
    if(NOT RESULT STREQUAL "0")
        message(FATAL_ERROR "Failed to create ${NAME} (${RESULT}): ${ERROR_OUTPUT}")
    endif()
    file(RENAME "${TEMPORARY_ARCHIVE_PATH}" "${ARCHIVE_PATH}")
    file(SHA256 "${ARCHIVE_PATH}" CHECKSUM)
    set_property(GLOBAL APPEND PROPERTY NOMAD_DISTRIBUTION_CHECKSUMS "${CHECKSUM}  ${NAME}\n")
endfunction()

create_distribution_archive(
    "nomad-sdk-${NOMAD_DISTRIBUTION_PLATFORM}-${NOMAD_DISTRIBUTION_VERSION}.zip"
    "${SDK}"
)
create_distribution_archive(
    "nomad-runtime-${NOMAD_DISTRIBUTION_PLATFORM}-${NOMAD_DISTRIBUTION_VERSION}.zip"
    "${RUNTIME_BUNDLE}"
)
get_property(CHECKSUMS GLOBAL PROPERTY NOMAD_DISTRIBUTION_CHECKSUMS)
list(JOIN CHECKSUMS "" CHECKSUMS)
file(WRITE "${NOMAD_DISTRIBUTION_OUTPUT}/SHA256SUMS.txt" "${CHECKSUMS}")
file(REMOVE_RECURSE "${STAGING}")
