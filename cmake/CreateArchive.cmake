if(NOT DEFINED NOMAD_ARCHIVE_OUTPUT)
    message(FATAL_ERROR "NOMAD_ARCHIVE_OUTPUT is required")
endif()
if(NOT DEFINED NOMAD_ARCHIVE_ROOT)
    message(FATAL_ERROR "NOMAD_ARCHIVE_ROOT is required")
endif()

file(
    GLOB_RECURSE ARCHIVE_FILES
    LIST_DIRECTORIES FALSE
    RELATIVE "${NOMAD_ARCHIVE_ROOT}"
    "${NOMAD_ARCHIVE_ROOT}/*"
)
list(SORT ARCHIVE_FILES)

file(
    ARCHIVE_CREATE
    OUTPUT "${NOMAD_ARCHIVE_OUTPUT}"
    PATHS ${ARCHIVE_FILES}
    FORMAT zip
    MTIME 0
)
