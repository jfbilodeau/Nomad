schema = 1

[project]
name = "{{project_name_toml}}"
identifier = "com.example.{{project_executable}}"
version = "0.1.0"
executable = "{{project_executable}}"

[nomad]
version = "{{nomad_version}}"
modules = ["nomad-game"]

[game]
entry = "main"
debug = false

[scripts]
directories = ["res/scripts"]

[resources]
directory = "res"

[text]
directories = ["text/text.csv"]

[window]
title = "{{project_name_toml}}"
resolution = [800, 600]
fullscreen = false
# splash-image = "splash.png"

[package]
output = "dist"
exclude = [
    "**/*.aseprite",
    "**/*.psd",
    "**/*.kra",
    "development/**"
]
