schema = 1

[project]
name = "{{project_name_toml}}"
identifier = "com.example.{{project_executable}}"
version = "0.1.0"
executable = "{{project_executable}}"
entry = "init"

[nomad]
version = "{{nomad_version}}"

[game]
debug = false

[resources]
directory = "res"

[window]
title = "{{project_name_toml}}"
resolution = [800, 600]
fullscreen = false
# splash-image = "splash.png"

[package]
output = "dist"
exclude = [
    "**/*.aseprite",
    "**/*.psd",
    "**/*.kra",
    "development/**"
]
