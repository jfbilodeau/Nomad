{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "development-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "FETCHCONTENT_UPDATES_DISCONNECTED": true
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "development-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "development-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "description": "Visual Studio Debug build for local development",
      "inherits": "windows-base"
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "description": "Visual Studio optimized release build",
      "inherits": "windows-base"
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Cross-platform Ninja Release build for continuous integration",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "Ninja Debug build for local development",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "Ninja optimized release build",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-sanitizers",
      "displayName": "Linux sanitizers",
      "description": "Ninja RelWithDebInfo build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NOMAD_ENABLE_SANITIZERS": true,
        "NOMAD_WARNINGS_AS_ERRORS": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "base",
      "hidden": true,
      "targets": [
        "nomad-cli",
        "nomad-packager",
        "nomad-runtime",
        "nomadc",
        "nomad_test"
      ]
    },
    {
      "name": "windows-debug",
      "inherits": "base",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "ci",
      "inherits": "base",
      "configurePreset": "ci"
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-sanitizers",
      "configurePreset": "linux-sanitizers",
      "targets": [
        "nomad_test"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "base",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "ci",
      "inherits": "base",
      "configurePreset": "ci"
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-sanitizers",
      "inherits": "base",
      "configurePreset": "linux-sanitizers"
    }
  ]
}
