if(NOT DEFINED NOMAD_DISTRIBUTION_OUTPUT)
    set(NOMAD_DISTRIBUTION_OUTPUT "${CMAKE_CURRENT_LIST_DIR}")
endif()
get_filename_component(NOMAD_DISTRIBUTION_OUTPUT "${NOMAD_DISTRIBUTION_OUTPUT}" ABSOLUTE)
if(NOT DEFINED NOMAD_TEST_ROOT)
    set(NOMAD_TEST_ROOT "${NOMAD_DISTRIBUTION_OUTPUT}/smoke-test")
endif()
if(EXISTS "${NOMAD_TEST_ROOT}")
    message(FATAL_ERROR "Distribution smoke test requires a new directory: ${NOMAD_TEST_ROOT}")
endif()

file(STRINGS "${NOMAD_DISTRIBUTION_OUTPUT}/SHA256SUMS.txt" CHECKSUMS)
list(LENGTH CHECKSUMS CHECKSUM_COUNT)
if(NOT CHECKSUM_COUNT EQUAL 2)
    message(FATAL_ERROR "Expected SDK and runtime checksums")
endif()
foreach(LINE IN LISTS CHECKSUMS)
    if(NOT LINE MATCHES "^([0-9a-f]+)  (nomad-(sdk|runtime)-[a-z0-9-]+-[0-9.]+\\.zip)$")
        message(FATAL_ERROR "Invalid checksum entry: ${LINE}")
    endif()
    set(EXPECTED "${CMAKE_MATCH_1}")
    set(NAME "${CMAKE_MATCH_2}")
    set(TYPE "${CMAKE_MATCH_3}")
    if(DEFINED ${TYPE}_NAME)
        message(FATAL_ERROR "Duplicate ${TYPE} checksum entry")
    endif()
    set(${TYPE}_NAME "${NAME}")
    file(SHA256 "${NOMAD_DISTRIBUTION_OUTPUT}/${NAME}" ACTUAL)
    if(NOT EXPECTED STREQUAL ACTUAL)
        message(FATAL_ERROR "Checksum mismatch for ${NAME}")
    endif()
endforeach()
if(NOT DEFINED sdk_NAME OR NOT DEFINED runtime_NAME)
    message(FATAL_ERROR "Checksums must declare one SDK and one runtime archive")
endif()

set(SDK "${NOMAD_TEST_ROOT}/SDK with spaces")
set(BUNDLE "${SDK}/runtime")
set(RUNTIME "${NOMAD_TEST_ROOT}/Runtime with spaces")
file(ARCHIVE_EXTRACT INPUT "${NOMAD_DISTRIBUTION_OUTPUT}/${sdk_NAME}" DESTINATION "${SDK}")
file(ARCHIVE_EXTRACT INPUT "${NOMAD_DISTRIBUTION_OUTPUT}/${runtime_NAME}" DESTINATION "${RUNTIME}")
foreach(MODULE IN ITEMS nomad-collections nomad-log nomad-system nomad-game nomad-os)
    if(NOT EXISTS "${SDK}/modules/${MODULE}/module.toml")
        message(FATAL_ERROR "SDK distribution is missing module ${MODULE}")
    endif()
endforeach()
file(READ "${BUNDLE}/runtime.json" MANIFEST)
string(JSON VERSION GET "${MANIFEST}" version)
string(JSON TARGET GET "${MANIFEST}" target)
string(JSON FILE_COUNT LENGTH "${MANIFEST}" files)
math(EXPR LAST_FILE "${FILE_COUNT} - 1")
set(EXPECTED_RUNTIME_FILES runtime.json)
foreach(INDEX RANGE ${LAST_FILE})
    string(JSON PATH GET "${MANIFEST}" files ${INDEX} path)
    string(JSON ROLE GET "${MANIFEST}" files ${INDEX} role)
    if(NOT EXISTS "${BUNDLE}/${PATH}")
        message(FATAL_ERROR "Missing declared runtime bundle file: ${PATH}")
    endif()
    if(NOT EXISTS "${RUNTIME}/${PATH}")
        message(FATAL_ERROR "Missing runtime archive file: ${PATH}")
    endif()
    list(APPEND EXPECTED_RUNTIME_FILES "${PATH}")
    if(ROLE STREQUAL "runtime")
        if(DEFINED RUNTIME_NAME)
            message(FATAL_ERROR "Runtime manifest declares multiple runtime executables")
        endif()
        set(RUNTIME_NAME "${PATH}")
    endif()
endforeach()
if(NOT DEFINED RUNTIME_NAME)
    message(FATAL_ERROR "Runtime manifest does not declare a runtime executable")
endif()
file(GLOB_RECURSE ACTUAL_RUNTIME_FILES LIST_DIRECTORIES FALSE RELATIVE "${RUNTIME}" "${RUNTIME}/*")
list(SORT EXPECTED_RUNTIME_FILES)
list(SORT ACTUAL_RUNTIME_FILES)
if(NOT ACTUAL_RUNTIME_FILES STREQUAL EXPECTED_RUNTIME_FILES)
    message(FATAL_ERROR
        "Runtime archive payload does not match runtime.json.\n"
        "Expected: ${EXPECTED_RUNTIME_FILES}\n"
        "Actual: ${ACTUAL_RUNTIME_FILES}"
    )
endif()
file(READ "${RUNTIME}/runtime.json" RUNTIME_MANIFEST)
string(JSON RUNTIME_VERSION GET "${RUNTIME_MANIFEST}" version)
string(JSON RUNTIME_TARGET GET "${RUNTIME_MANIFEST}" target)
if(NOT RUNTIME_VERSION STREQUAL VERSION OR NOT RUNTIME_TARGET STREQUAL TARGET)
    message(FATAL_ERROR "Runtime archive manifest does not match the SDK runtime manifest")
endif()

if(CMAKE_HOST_WIN32)
    set(SUFFIX ".exe")
    set(ENV{PATH} "$ENV{SystemRoot}/System32;$ENV{SystemRoot}")
else()
    set(SUFFIX "")
    set(ENV{PATH} "/usr/bin:/bin")
endif()
unset(ENV{LD_LIBRARY_PATH})
unset(ENV{LD_PRELOAD})
unset(ENV{DYLD_LIBRARY_PATH})
unset(ENV{DYLD_FALLBACK_LIBRARY_PATH})

include("${CMAKE_CURRENT_LIST_DIR}/TestProcess.cmake")

function(run_success)
    nomadRunTestCommand("Extracted SDK command" COMMAND ${ARGV}
        WORKING_DIRECTORY "${NOMAD_TEST_ROOT}")
endfunction()

set(SDK_PROGRAMS nomad nomadc)
if(NOMAD_DISTRIBUTION_LSP OR EXISTS "${SDK}/nomad-lsp${SUFFIX}")
    list(APPEND SDK_PROGRAMS nomad-lsp)
endif()
foreach(PROGRAM IN LISTS SDK_PROGRAMS)
    nomadRunTestCommand("Extracted ${PROGRAM} version"
        COMMAND "${SDK}/${PROGRAM}${SUFFIX}" --version
        WORKING_DIRECTORY "${NOMAD_TEST_ROOT}"
        OUTPUT_VARIABLE OUTPUT)
    string(STRIP "${OUTPUT}" OUTPUT)
    string(FIND "${OUTPUT}" "${VERSION}" VERSION_POSITION)
    if(VERSION_POSITION LESS 0)
        message(FATAL_ERROR "Extracted ${PROGRAM} version mismatch:\n${OUTPUT}")
    endif()
endforeach()
set(PROJECT "${NOMAD_TEST_ROOT}/game")
run_success("${SDK}/nomad${SUFFIX}" init "${PROJECT}")
run_success("${SDK}/nomad${SUFFIX}" check "${PROJECT}")
run_success("${SDK}/nomad${SUFFIX}" package "${PROJECT}")
run_success("${SDK}/nomad-runtime${SUFFIX}" --help)
run_success("${BUNDLE}/${RUNTIME_NAME}" --help)
run_success("${RUNTIME}/${RUNTIME_NAME}" --help)
message(STATUS "Extracted SDK and standalone runtime archives passed isolated validation")
file(REMOVE_RECURSE "${NOMAD_TEST_ROOT}")
