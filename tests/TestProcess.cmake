include_guard(GLOBAL)

function(nomadRunTestCommand DESCRIPTION)
    cmake_parse_arguments(PARSE_ARGV 1 PROCESS "EXPECT_FAILURE"
        "WORKING_DIRECTORY;OUTPUT_VARIABLE;ERROR_VARIABLE;OUTPUT_MATCH" "COMMAND")
    if(PROCESS_UNPARSED_ARGUMENTS OR PROCESS_KEYWORDS_MISSING_VALUES OR NOT PROCESS_COMMAND)
        message(FATAL_ERROR "Invalid test command arguments: ${DESCRIPTION}")
    endif()
    set(DIRECTORY_ARGUMENTS "")
    if(DEFINED PROCESS_WORKING_DIRECTORY)
        list(APPEND DIRECTORY_ARGUMENTS WORKING_DIRECTORY "${PROCESS_WORKING_DIRECTORY}")
    endif()
    execute_process(COMMAND ${PROCESS_COMMAND} ${DIRECTORY_ARGUMENTS}
        RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR_OUTPUT
        ENCODING UTF-8 TIMEOUT 30)
    set(FAILED FALSE)
    if(PROCESS_EXPECT_FAILURE)
        if(NOT RESULT MATCHES "^[0-9]+$" OR RESULT STREQUAL "0")
            set(FAILED TRUE)
        endif()
    elseif(NOT RESULT STREQUAL "0")
        set(FAILED TRUE)
    endif()
    if(DEFINED PROCESS_OUTPUT_MATCH AND NOT OUTPUT MATCHES "${PROCESS_OUTPUT_MATCH}")
        set(FAILED TRUE)
    endif()
    if(FAILED)
        message(FATAL_ERROR "${DESCRIPTION} failed (${RESULT})\nstdout:\n${OUTPUT}\nstderr:\n${ERROR_OUTPUT}")
    endif()
    if(DEFINED PROCESS_OUTPUT_VARIABLE)
        set("${PROCESS_OUTPUT_VARIABLE}" "${OUTPUT}" PARENT_SCOPE)
    endif()
    if(DEFINED PROCESS_ERROR_VARIABLE)
        set("${PROCESS_ERROR_VARIABLE}" "${ERROR_OUTPUT}" PARENT_SCOPE)
    endif()
endfunction()
