include("${CMAKE_CURRENT_LIST_DIR}/TestProcess.cmake")

nomadRunTestCommand("LSP help" COMMAND "${NOMAD_LSP}" --help OUTPUT_MATCH "Usage: nomad-lsp")
nomadRunTestCommand("LSP version" COMMAND "${NOMAD_LSP}" --version OUTPUT_MATCH "${NOMAD_VERSION}")
nomadRunTestCommand("LSP rejects unknown options" COMMAND "${NOMAD_LSP}" --unknown EXPECT_FAILURE)
nomadRunTestCommand("LSP rejects abbreviated options" COMMAND "${NOMAD_LSP}" --ver EXPECT_FAILURE)
nomadRunTestCommand("LSP rejects positional arguments" COMMAND "${NOMAD_LSP}" project EXPECT_FAILURE)

if(EXISTS "${NOMAD_TEST_ROOT}")
    message(FATAL_ERROR "LSP process test requires a new directory: ${NOMAD_TEST_ROOT}")
endif()
file(MAKE_DIRECTORY "${NOMAD_TEST_ROOT}/project with spaces/res/scripts")
file(WRITE "${NOMAD_TEST_ROOT}/project with spaces/nomad.toml"
    "schema = 1\n[project]\nname = \"LSP test\"\nidentifier = \"org.nomad.lsp\"\n"
    "version = \"0.1.0\"\nexecutable = \"lsp-test\"\n[game]\nentry = \"init\"\n"
    "[nomad]\nversion = \"${NOMAD_VERSION}\"\nmodules = [\"game\"]\n"
    "[scripts]\ndirectories = [\"res/scripts\"]\n[resources]\ndirectory = \"res\"\n")
set(SCRIPT "${NOMAD_TEST_ROOT}/project with spaces/res/scripts/init.nomad")
file(WRITE "${SCRIPT}" "print \"disk\"")
set(URI_PATH "${SCRIPT}")
if(NOT URI_PATH MATCHES "^/")
    string(PREPEND URI_PATH "/")
endif()
string(REPLACE " " "%20" URI_PATH "${URI_PATH}")
set(URI "file://${URI_PATH}")

function(append_message BODY)
    string(CONFIGURE "${BODY}" BODY @ONLY)
    string(LENGTH "${BODY}" LENGTH)
    set(INPUT "${INPUT}Content-Length: ${LENGTH}\n\n${BODY}" PARENT_SCOPE)
endfunction()

set(INPUT "")
append_message([=[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}]=])
append_message([=[{"jsonrpc":"2.0","method":"initialized","params":{}}]=])
append_message([=[{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@URI@","languageId":"nomad","version":1,"text":"print missing"}}}]=])
append_message([=[{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"@URI@","version":2},"contentChanges":[{"text":"print \"editor\""}]}}]=])
append_message([=[{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"@URI@"}}}]=])
append_message([=[{"jsonrpc":"2.0","id":2,"method":"shutdown"}]=])
append_message([=[{"jsonrpc":"2.0","method":"exit"}]=])
file(CONFIGURE OUTPUT "${NOMAD_TEST_ROOT}/input" CONTENT "${INPUT}" @ONLY NEWLINE_STYLE CRLF)
execute_process(COMMAND "${NOMAD_LSP}" INPUT_FILE "${NOMAD_TEST_ROOT}/input"
    OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERRORS RESULT_VARIABLE RESULT TIMEOUT 30 ENCODING UTF-8)
if(NOT RESULT STREQUAL "0")
    message(FATAL_ERROR "LSP process failed (${RESULT}): ${ERRORS}")
endif()
execute_process(COMMAND "${NOMAD_LSP}" --stdio INPUT_FILE "${NOMAD_TEST_ROOT}/input"
    OUTPUT_VARIABLE STDIO_OUTPUT ERROR_VARIABLE STDIO_ERRORS RESULT_VARIABLE STDIO_RESULT
    TIMEOUT 30 ENCODING UTF-8)
if(NOT STDIO_RESULT STREQUAL "0")
    message(FATAL_ERROR "LSP --stdio process failed (${STDIO_RESULT}): ${STDIO_ERRORS}")
endif()
if(NOT STDIO_OUTPUT STREQUAL OUTPUT)
    message(FATAL_ERROR "Explicit --stdio transport differs from the default transport")
endif()

function(parse_messages OUTPUT RESULT)
    set(MESSAGES "")
    while(NOT OUTPUT STREQUAL "")
        if(NOT OUTPUT MATCHES "^Content-Length: ([0-9]+)\r?\n\r?\n")
            message(FATAL_ERROR "Corrupt LSP output: ${OUTPUT}")
        endif()
        set(LENGTH "${CMAKE_MATCH_1}")
        string(LENGTH "${CMAKE_MATCH_0}" HEADER_LENGTH)
        string(SUBSTRING "${OUTPUT}" ${HEADER_LENGTH} ${LENGTH} BODY)
        string(JSON TYPE TYPE "${BODY}")
        if(NOT TYPE STREQUAL "OBJECT")
            message(FATAL_ERROR "Expected JSON-RPC object: ${BODY}")
        endif()
        list(APPEND MESSAGES "${BODY}")
        math(EXPR OFFSET "${HEADER_LENGTH} + ${LENGTH}")
        string(SUBSTRING "${OUTPUT}" ${OFFSET} -1 OUTPUT)
    endwhile()
    set("${RESULT}" "${MESSAGES}" PARENT_SCOPE)
endfunction()
parse_messages("${OUTPUT}" MESSAGES)
list(LENGTH MESSAGES COUNT)
if(NOT COUNT EQUAL 5)
    message(FATAL_ERROR "Expected initialize, three diagnostics, and shutdown: ${MESSAGES}\n${ERRORS}")
endif()
foreach(INDEX RANGE 1 3)
    list(GET MESSAGES ${INDEX} BODY)
    string(JSON METHOD GET "${BODY}" method)
    string(JSON ACTUAL_URI GET "${BODY}" params uri)
    string(JSON DIAGNOSTICS LENGTH "${BODY}" params diagnostics)
    if(NOT METHOD STREQUAL "textDocument/publishDiagnostics" OR NOT ACTUAL_URI STREQUAL URI)
        message(FATAL_ERROR "Unexpected diagnostics: ${BODY}")
    endif()
    if(INDEX EQUAL 1)
        set(EXPECTED_COUNT 1)
    else()
        set(EXPECTED_COUNT 0)
    endif()
    if(NOT DIAGNOSTICS EQUAL EXPECTED_COUNT)
        message(FATAL_ERROR "Unexpected diagnostic count: ${BODY}")
    endif()
    if(INDEX LESS 3)
        string(JSON VERSION GET "${BODY}" params version)
        if(NOT VERSION EQUAL INDEX)
            message(FATAL_ERROR "Unexpected document version: ${BODY}")
        endif()
    endif()
endforeach()
file(READ "${SCRIPT}" DISK_TEXT)
if(NOT DISK_TEXT STREQUAL "print \"disk\"")
    message(FATAL_ERROR "LSP modified the backing script")
endif()

get_filename_component(SDK_DIRECTORY "${NOMAD_LSP}" DIRECTORY)
get_filename_component(LSP_FILENAME "${NOMAD_LSP}" NAME)
set(ISOLATED_SDK "${NOMAD_TEST_ROOT}/isolated-sdk")
file(MAKE_DIRECTORY "${ISOLATED_SDK}/modules")
set(NOMAD_RUNTIME "${NOMAD_LSP}")
set(NOMAD_RUNTIME_DESTINATION "${ISOLATED_SDK}")
if(WIN32)
    set(NOMAD_RUNTIME_DEPENDENCIES "${NOMAD_LSP_RUNTIME_DEPENDENCIES}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/BundleRuntimeDependencies.cmake")
file(COPY "${SDK_DIRECTORY}/modules/system" DESTINATION "${ISOLATED_SDK}/modules")
set(MODULE_SCRIPT "${ISOLATED_SDK}/modules/system/scripts/init.nomad")
file(WRITE "${MODULE_SCRIPT}" "fun moduleAnswer\nreturn 41\nend\nassert false\n")
file(READ "${NOMAD_TEST_ROOT}/project with spaces/nomad.toml" CONFIGURATION)
string(REPLACE "modules = [\"game\"]" "modules = [\"system\"]" CONFIGURATION "${CONFIGURATION}")
file(WRITE "${NOMAD_TEST_ROOT}/project with spaces/nomad.toml" "${CONFIGURATION}")
set(MODULE_URI_PATH "${MODULE_SCRIPT}")
if(NOT MODULE_URI_PATH MATCHES "^/")
    string(PREPEND MODULE_URI_PATH "/")
endif()
string(REPLACE " " "%20" MODULE_URI_PATH "${MODULE_URI_PATH}")
set(MODULE_URI "file://${MODULE_URI_PATH}")
set(INPUT "")
append_message([=[{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}]=])
append_message([=[{"jsonrpc":"2.0","method":"initialized","params":{}}]=])
append_message([=[{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@URI@","languageId":"nomad","version":1,"text":"answer = moduleAnswer\nassert answer == 42"}}}]=])
append_message([=[{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"@MODULE_URI@","languageId":"nomad","version":1,"text":"fun moduleAnswer\nreturn missing\nend"}}}]=])
append_message([=[{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"@MODULE_URI@","version":2},"contentChanges":[{"text":"fun moduleAnswer\nreturn 42\nend"}]}}]=])
append_message([=[{"jsonrpc":"2.0","id":10,"method":"textDocument/completion","params":{"textDocument":{"uri":"@URI@"},"position":{"line":1,"character":0}}}]=])
append_message([=[{"jsonrpc":"2.0","id":11,"method":"textDocument/hover","params":{"textDocument":{"uri":"@MODULE_URI@"},"position":{"line":0,"character":7}}}]=])
append_message([=[{"jsonrpc":"2.0","id":2,"method":"shutdown"}]=])
append_message([=[{"jsonrpc":"2.0","method":"exit"}]=])
file(CONFIGURE OUTPUT "${NOMAD_TEST_ROOT}/module-input" CONTENT "${INPUT}" @ONLY NEWLINE_STYLE CRLF)
execute_process(COMMAND "${ISOLATED_SDK}/${LSP_FILENAME}" INPUT_FILE "${NOMAD_TEST_ROOT}/module-input"
    OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERRORS RESULT_VARIABLE RESULT TIMEOUT 30 ENCODING UTF-8)
if(NOT RESULT STREQUAL "0" OR NOT ERRORS STREQUAL "")
    message(FATAL_ERROR "Module-source LSP process failed (${RESULT}): ${ERRORS}")
endif()
parse_messages("${OUTPUT}" MESSAGES)
set(MODULE_ERROR FALSE)
set(MODULE_CLEARED FALSE)
set(MODULE_COMPLETION FALSE)
set(MODULE_HOVER FALSE)
foreach(BODY IN LISTS MESSAGES)
    string(JSON METHOD ERROR_VARIABLE METHOD_ERROR GET "${BODY}" method)
    if(NOT METHOD_ERROR AND METHOD STREQUAL "textDocument/publishDiagnostics")
        string(JSON ACTUAL_URI GET "${BODY}" params uri)
        string(JSON COUNT LENGTH "${BODY}" params diagnostics)
        if(ACTUAL_URI STREQUAL MODULE_URI)
            string(JSON VERSION GET "${BODY}" params version)
            if(VERSION EQUAL 1 AND COUNT GREATER 0)
                string(JSON LINE GET "${BODY}" params diagnostics 0 range start line)
                if(NOT LINE EQUAL 1)
                    message(FATAL_ERROR "Module diagnostics did not use the editor source location: ${BODY}")
                endif()
                set(MODULE_ERROR TRUE)
            elseif(VERSION EQUAL 2 AND COUNT EQUAL 0)
                set(MODULE_CLEARED TRUE)
            endif()
        endif()
    elseif(METHOD_ERROR)
        string(JSON ID ERROR_VARIABLE ID_ERROR GET "${BODY}" id)
        if(NOT ID_ERROR AND ID EQUAL 10)
            string(JSON COMPLETIONS GET "${BODY}" result)
            if(NOT COMPLETIONS MATCHES "moduleAnswer" OR COMPLETIONS MATCHES "\\$system\\.init")
                message(FATAL_ERROR "Module declarations or internal file visibility are incorrect: ${BODY}")
            endif()
            set(MODULE_COMPLETION TRUE)
        elseif(NOT ID_ERROR AND ID EQUAL 11)
            string(JSON HOVER GET "${BODY}" result)
            if(NOT HOVER MATCHES "moduleAnswer")
                message(FATAL_ERROR "Module editor buffer is not part of project analysis: ${BODY}")
            endif()
            set(MODULE_HOVER TRUE)
        endif()
    elseif(METHOD STREQUAL "window/showMessage")
        message(FATAL_ERROR "Module-source analysis failed: ${BODY}")
    endif()
endforeach()
if(NOT MODULE_ERROR OR NOT MODULE_CLEARED OR NOT MODULE_COMPLETION OR NOT MODULE_HOVER)
    message(FATAL_ERROR "Missing module-source diagnostics, recovery, completion, or hover: ${MESSAGES}")
endif()
file(READ "${MODULE_SCRIPT}" MODULE_DISK_TEXT)
if(NOT MODULE_DISK_TEXT STREQUAL "fun moduleAnswer\nreturn 41\nend\nassert false\n")
    message(FATAL_ERROR "LSP modified the backing module script")
endif()
file(REMOVE_RECURSE "${NOMAD_TEST_ROOT}")
