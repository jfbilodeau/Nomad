{
  "name": "nomad-language",
  "displayName": "Nomad Language",
  "description": "Syntax highlighting for Nomad (.nomad) scripts",
  "version": "0.1.2",
  "license": "MIT",
  "publisher": "Chronogears",
  "repository": {
    "type": "git",
    "url": "https://github.com/jfbilodeau/Nomad.git"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "files": [
    "language-configuration.json",
    "syntaxes/**",
    "README.md",
    "LICENSE"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nomad",
        "aliases": [
          "Nomad",
          "nomad"
        ],
        "extensions": [
          ".nomad"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nomad",
        "scopeName": "source.nomad",
        "path": "./syntaxes/nomad.tmLanguage.json"
      }
    ]
  }
}
