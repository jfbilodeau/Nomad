{
  "name": "nomad-language",
  "displayName": "Nomad Language",
  "description": "Syntax highlighting and compiler diagnostics for Nomad (.nomad) scripts",
  "version": "0.1.2",
  "license": "MIT",
  "publisher": "Chronogears",
  "repository": {
    "type": "git",
    "url": "https://github.com/jfbilodeau/Nomad.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./extension.js",
  "activationEvents": ["onLanguage:nomad"],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "scripts": {
    "check": "node --check extension.js"
  },
  "files": [
    "extension.js",
    "node_modules/**",
    "language-configuration.json",
    "syntaxes/**",
    "README.md",
    "LICENSE"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "title": "Nomad",
      "properties": {
        "nomad.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable compiler diagnostics. Reload the window after changing this setting."
        },
        "nomad.languageServer.path": {
          "type": "string",
          "default": "nomad-lsp",
          "description": "Path to the nomad-lsp executable. Reload the window after changing this setting."
        }
      }
    },
    "languages": [
      {
        "id": "nomad",
        "aliases": [
          "Nomad",
          "nomad"
        ],
        "extensions": [
          ".nomad"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nomad",
        "scopeName": "source.nomad",
        "path": "./syntaxes/nomad.tmLanguage.json"
      }
    ]
  }
}
